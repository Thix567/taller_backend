# Copie este archivo como .env y ajuste los valores.
# scripts/ejecutar.ps1 carga automaticamente las variables de este archivo.

# MySQL local de desarrollo (scripts/iniciar-mysql.ps1)
DB_PORT=3308
DB_USER=taller_app
DB_PASSWORD=taller123
# Deje vacio cuando el script inicializa su propia instancia local (root sin clave).
DB_ROOT_PASSWORD=

# Origen permitido por CORS. Si el frontend corre en otro puerto u host, cambielo.
CORS_ORIGINS=http://localhost:4200

# Clave JWT (HS256). Use una cadena larga y aleatoria en produccion.
JWT_SECRET=cambiar-esta-clave-por-una-larga-y-aleatoria-2026

# Usuario inicial creado solo si la tabla usuarios esta vacia
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=admin123
APP_ADMIN_NOMBRE=Administrador

# Ruta opcional a Maven si no esta en el PATH (solo Windows).
# MAVEN_PATH=C:\ruta\a\apache-maven\bin\mvn.cmd
